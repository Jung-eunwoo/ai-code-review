# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 gitignore 대상이다.
#   cp .env.example .env

# ── 필수 ────────────────────────────────────────────────────────────
# Google AI Studio 에서 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── 선택 ────────────────────────────────────────────────────────────
# 기본 모델. gemini-2.5-flash 가 더 빠르고 무료 한도가 넉넉하다.
# GEMINI_MODEL=gemini-2.5-pro

# gh CLI 가 이미 로그인돼 있으면 필요 없다. CI 는 워크플로가 자동 주입한다.
# GH_TOKEN=

# --provider claude 로 돌릴 때만
# ANTHROPIC_API_KEY=
